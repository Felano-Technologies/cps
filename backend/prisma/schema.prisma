generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  operations
  admin
  rider
}

enum VehicleType {
  motorbike
  van
  truck
}

enum RiderStatus {
  available
  en_route
  loading
  maintenance
  offline
}

enum ShipmentStatus {
  awaiting_price
  pending
  picked_up
  in_transit
  out_for_delivery
  delivered
  delayed
  failed
  cancelled
}

enum ShipmentPriority {
  standard
  high
}

enum ShipmentSpeed {
  same_day
  next_day
  express
}

enum PackageType {
  document
  parcel
  electronics
  fragile
  food
  other
}

enum PodMethod {
  signature
  photo
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  phone        String? @unique
  phoneVerified Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  riderProfile     RiderProfile?
  shipmentsAsOwner Shipment[]    @relation("CustomerShipments")
  notifications    Notification[]

  @@map("users")
}

model RiderProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId       String?
  vehicleType     VehicleType?
  currentStatus   RiderStatus @default(offline)
  currentLocation String?
  isVerified      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  assignedShipments Shipment[]       @relation("RiderShipments")
  deductions        RiderDeduction[]

  @@map("rider_profiles")
}

model Shipment {
  id             String           @id @default(cuid())
  trackingCode   String           @unique
  batchId        String?
  status         ShipmentStatus   @default(awaiting_price)
  priority       ShipmentPriority @default(standard)
  speed          ShipmentSpeed    @default(next_day)
  vehicleType    VehicleType
  packageType    PackageType

  customerId String?
  customer   User?   @relation("CustomerShipments", fields: [customerId], references: [id], onDelete: SetNull)

  assignedRiderId String?
  assignedRider   RiderProfile? @relation("RiderShipments", fields: [assignedRiderId], references: [id], onDelete: SetNull)

  senderName    String
  senderNumber  String
  senderContact String?
  pickupRegion  String
  pickupLocation String
  pickupDate    String?

  receiverName   String
  receiverNumber String
  dropoffRegion  String
  dropoffKumasiSubArea String?
  dropoffLocation String

  deliveryFee Decimal @db.Decimal(10, 2)
  productFee  Decimal? @db.Decimal(10, 2)
  weightKg    Decimal? @db.Decimal(10, 2)

  podMethod        PodMethod?
  podRecipientName String?
  podSignatureData String?
  podPhotoUrl      String?

  additionalInstructions String?
  opsRemarks             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents  ShipmentStatusEvent[]
  notifications Notification[]

  @@map("shipments")
}

model ShipmentStatusEvent {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  note       String?
  createdAt  DateTime       @default(now())

  @@map("shipment_status_events")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@map("notifications")
}

model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@map("phone_otps")
}

model RiderDeduction {
  id          String       @id @default(cuid())
  riderId     String
  rider       RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)
  amount      Decimal      @db.Decimal(10, 2)
  category    String       // late_delivery, damaged_goods, fuel_advance, equipment, disciplinary, loan_repayment, other
  reason      String
  shipmentId  String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("rider_deductions")
}
