generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  operations
  admin
  rider
  business
}

enum BusinessStatus {
  pending
  approved
  suspended
}

enum VehicleType {
  motorbike
  van
  truck
}

enum RiderStatus {
  available
  en_route
  loading
  maintenance
  offline
}

enum ShipmentStatus {
  awaiting_price
  pending
  picked_up
  in_transit
  out_for_delivery
  delivered
  delayed
  failed
  cancelled
}

enum ShipmentPriority {
  standard
  high
}

enum ShipmentSpeed {
  same_day
  next_day
  express
}

enum PackageType {
  document
  parcel
  electronics
  fragile
  food
  other
}

enum PackageSize {
  small
  medium
  big
}

enum DeliveryType {
  doorstep
  station
}

enum PodMethod {
  signature
  photo
}

enum BonusType {
  pickup
  dropoff
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  phone        String? @unique
  phoneVerified Boolean @default(false)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  riderProfile     RiderProfile?
  business         Business?
  shipmentsAsOwner Shipment[]    @relation("CustomerShipments")
  notifications    Notification[]

  @@map("users")
}

/// A company integrating with CPS through the Partner API (e.g. Shopyos).
/// Owned by a single `business` user; must be approved before keys work.
model Business {
  id            String         @id @default(cuid())
  ownerUserId   String         @unique
  owner         User           @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name          String
  contactEmail  String?
  contactPhone  String?
  status        BusinessStatus @default(pending)
  webhookUrl    String?
  webhookSecret String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  apiKeys       ApiKey[]
  shipments     Shipment[]
  webhookEvents WebhookEvent[]

  @@map("businesses")
}

model ApiKey {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  /// First characters of the key, safe to display (e.g. "cps_live_ab12cd").
  prefix     String
  /// SHA-256 of the full key; the key itself is never stored.
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId])
  @@map("api_keys")
}

/// Outbox of webhook deliveries to a business. Rows are written in the same
/// transaction as the shipment change, then sent (and retried) by the worker.
model WebhookEvent {
  id             String    @id @default(cuid())
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shipmentId     String?
  shipment       Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  type           String
  payload        Json
  sequence       Int       @default(autoincrement())
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  deliveredAt    DateTime?
  failedAt       DateTime?
  lastStatusCode Int?
  lastError      String?
  createdAt      DateTime  @default(now())

  @@index([deliveredAt, failedAt, nextAttemptAt])
  @@index([businessId, createdAt])
  @@map("webhook_events")
}

model RiderProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId       String?
  vehicleType     VehicleType?
  currentStatus   RiderStatus @default(offline)
  currentLocation String?
  isVerified      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  assignedShipments Shipment[]       @relation("RiderShipments")
  pickupShipments   Shipment[]       @relation("PickupRiderShipments")
  dropoffShipments  Shipment[]       @relation("DropoffRiderShipments")
  deductions        RiderDeduction[]
  bonuses           RiderBonus[]

  @@map("rider_profiles")
}

model Shipment {
  id             String           @id @default(cuid())
  trackingCode   String           @unique
  batchId        String?
  status         ShipmentStatus   @default(awaiting_price)
  priority       ShipmentPriority @default(standard)
  speed          ShipmentSpeed    @default(next_day)
  vehicleType    VehicleType
  packageType    PackageType
  packageSize    PackageSize @default(medium)
  deliveryType   DeliveryType @default(doorstep)

  customerId String?
  customer   User?   @relation("CustomerShipments", fields: [customerId], references: [id], onDelete: SetNull)

  assignedRiderId String?
  assignedRider   RiderProfile? @relation("RiderShipments", fields: [assignedRiderId], references: [id], onDelete: SetNull)

  pickupRiderId   String?
  pickupRider     RiderProfile? @relation("PickupRiderShipments", fields: [pickupRiderId], references: [id], onDelete: SetNull)

  dropoffRiderId  String?
  dropoffRider    RiderProfile? @relation("DropoffRiderShipments", fields: [dropoffRiderId], references: [id], onDelete: SetNull)

  senderName    String
  senderNumber  String
  senderContact String?
  pickupRegion  String
  pickupLocation String
  pickupDate    String?

  receiverName   String
  receiverNumber String
  dropoffRegion  String
  dropoffKumasiSubArea String?
  dropoffLocation String
  stationLocation String?

  stationDriverName   String?
  stationDriverNumber String?
  stationCarNumber    String?
  stationReceiptUrl   String?
  stationHandoverAt   DateTime?

  deliveryFee Decimal @db.Decimal(10, 2)
  productFee  Decimal? @db.Decimal(10, 2)
  weightKg    Decimal? @db.Decimal(10, 2)

  podMethod        PodMethod?
  podRecipientName String?
  podSignatureData String?
  podPhotoUrl      String?
  packageImageUrl  String?

  additionalInstructions String?
  opsRemarks             String?

  // Partner API (orders created by a Business through /api/partner/v1)
  businessId        String?
  business          Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  externalReference String?
  /// Delivery fee already collected by the partner; never ask the receiver to pay.
  prepaid           Boolean   @default(false)

  // Partner-supplied delivery code the rider must enter at proof of delivery
  deliveryCodeHash         String?
  deliveryCodeAttempts     Int       @default(0)
  deliveryCodeVerifiedAt   DateTime?
  deliveryCodeOverrideNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusEvents  ShipmentStatusEvent[]
  notifications Notification[]
  bonuses       RiderBonus[]
  webhookEvents WebhookEvent[]

  @@unique([businessId, externalReference])
  @@index([businessId, updatedAt])
  @@map("shipments")
}

model ShipmentStatusEvent {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     ShipmentStatus
  note       String?
  createdAt  DateTime       @default(now())

  @@map("shipment_status_events")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@map("notifications")
}

model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@map("phone_otps")
}

model RiderDeduction {
  id          String       @id @default(cuid())
  riderId     String
  rider       RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)
  amount      Decimal      @db.Decimal(10, 2)
  category    String       // late_delivery, damaged_goods, fuel_advance, equipment, disciplinary, loan_repayment, other
  reason      String
  shipmentId  String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("rider_deductions")
}

model RiderBonus {
  id         String       @id @default(cuid())
  riderId    String
  rider      RiderProfile @relation(fields: [riderId], references: [id], onDelete: Cascade)
  shipmentId String
  shipment   Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  type       BonusType
  amount     Decimal      @default(1.00) @db.Decimal(10, 2)
  createdAt  DateTime     @default(now())

  @@unique([shipmentId, type])
  @@index([riderId])
  @@index([createdAt])
  @@map("rider_bonuses")
}
